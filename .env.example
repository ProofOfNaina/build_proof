# Which Shelby network to use: SHELBYNET (default), TESTNET, or LOCAL.
# Leave unset for shelbynet. See README for why testnet does not currently work.
NEXT_PUBLIC_SHELBY_NETWORK=

# API key — OPTIONAL. Shelbynet serves the Aptos node and blob RPC anonymously,
# so you do not need one to use this app on shelbynet.
#
# IMPORTANT: keys are network-specific. Sending a key issued for a different
# network is WORSE than sending none — the endpoint answers every request with
# "401 Unauthorized: API key not found". The key is therefore only used when the
# variable below names the network it belongs to.
#
# NOTE: NEXT_PUBLIC_ means this value is embedded in the client bundle and is
# publicly visible. Restrict it by domain and rate limit it; never use a secret.
NEXT_PUBLIC_SHELBY_API_KEY=

# The network your API key was issued for. The key above is ignored unless this
# matches NEXT_PUBLIC_SHELBY_NETWORK.
NEXT_PUBLIC_SHELBY_API_KEY_NETWORK=

# Shelby storage location (region) for uploads. Optional — resolved from the
# chain's activated locations when unset (shelbynet currently has one:
# "shelbynet-1"). Set it to skip that lookup or to pin a specific region.
NEXT_PUBLIC_SHELBY_LOCATION=
