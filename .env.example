# API key for Shelby / Aptos services.
# NOTE: NEXT_PUBLIC_ means this is embedded in the client bundle and publicly
# visible. Restrict it by domain and rate limit it; never use a secret key here.
# The key must be issued for the network selected below.
NEXT_PUBLIC_SHELBY_API_KEY=

# Which Shelby network to use: SHELBYNET (default), TESTNET, or LOCAL.
# Leave unset for shelbynet. See README for why testnet does not currently work.
NEXT_PUBLIC_SHELBY_NETWORK=
